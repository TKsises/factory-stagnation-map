# Smart Craft API のキー。
# ★このファイルは雛形。実際のキーは .env.local に書く（Git に入らない）。
#
#   1. cp .env.example .env.local
#   2. .env.local の値を実際のキーに書き換える
#   3. npm run dev
#
# ★VITE_ を付けないこと。付けるとブラウザに埋め込まれて誰でも読めるようになる。
SMARTCRAFT_API_KEY=

# 接続先。省略すると本番（https://api.smartcraft.jp/api/v1）になる。
# ★トークンは発行した環境でしか通らない。
#   検証環境（app.staging.smartcraft.jp）で発行したなら、こちらを指定する:
# SMARTCRAFT_API_BASE=https://api.staging.smartcraft.jp/api/v1
